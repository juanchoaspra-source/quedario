{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quedario",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-07",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "durable_objects": { "bindings": [{ "name": "GROUPS", "class_name": "Group" }, { "name": "NAMES", "class_name": "Names" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Group"] }, { "tag": "v2", "new_sqlite_classes": ["Names"] }]
}
